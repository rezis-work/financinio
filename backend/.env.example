# Application
APP_NAME=Financinio
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Neon Serverless PostgreSQL)
# Example: postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./financinio_dev.db

# JWT Security (change in production!)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Pluggable File Storage ("local" or "s3")
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
# Optional S3 / Cloudflare R2 settings when STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upstash Vector (for merchant categorization memory & document RAG)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Provider-Agnostic LLM Config ("google_genai", "openai", or "anthropic")
LLM_PROVIDER=google_genai
LLM_MODEL_FAST=gemini-2.5-flash
LLM_MODEL_VISION=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financinio-dev

# Admin Dashboard & Per-User AI Token Quotas
ADMIN_EMAILS=revazikaranadze08@gmail.com
DEFAULT_USER_AI_TOKEN_LIMIT=50000
